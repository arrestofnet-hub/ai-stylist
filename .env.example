APP_NAME=AI Stylist
APP_ENV=development
HOST=0.0.0.0
PORT=8010

DATABASE_PATH=data/ai_stylist.db
UPLOAD_DIR=uploads
GENERATED_DIR=generated

# Add locally/on the server. Never commit real secrets.
OPENAI_API_KEY=

PREVIEW_IMAGE_MODEL=gpt-image-2.5-flare
FINAL_IMAGE_MODEL=gpt-image-2.5-sunburst
PREVIEW_IMAGE_QUALITY=low
FINAL_IMAGE_QUALITY=medium
IMAGE_SIZE=1024x1536
IMAGE_OUTPUT_FORMAT=webp
IMAGE_OUTPUT_COMPRESSION=88
MAX_REFERENCE_IMAGES=3
