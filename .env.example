APP_NAME=AI Stylist
APP_ENV=development
HOST=0.0.0.0
PORT=8010
MCP_PORT=8011
PUBLIC_BASE_URL=http://localhost:8010

DATABASE_PATH=data/ai_stylist.db
UPLOAD_DIR=uploads
GENERATED_DIR=generated

# Add locally/on the server. Never commit real secrets.
OPENAI_API_KEY=
ADMIN_API_KEY=
OPENAI_APPS_CHALLENGE_TOKEN=

# Personal beta can run without OAuth. Enable these before public multi-user launch.
MCP_AUTH_ENABLED=false
OAUTH_ISSUER_URL=
OAUTH_JWKS_URL=
MCP_RESOURCE_URL=
OAUTH_REQUIRED_SCOPES=stylist
OAUTH_ALGORITHMS=RS256

PREVIEW_IMAGE_MODEL=gpt-image-2.5-flare
FINAL_IMAGE_MODEL=gpt-image-2.5-sunburst
PREVIEW_IMAGE_QUALITY=medium
FINAL_IMAGE_QUALITY=medium
IMAGE_SIZE=1024x1536
IMAGE_OUTPUT_FORMAT=webp
IMAGE_OUTPUT_COMPRESSION=88
MAX_REFERENCE_IMAGES=3
FREE_TRIES_ON_SIGNUP=3
PREVIEW_CREDIT_COST=1
FINAL_CREDIT_COST=4
STALE_GENERATION_MINUTES=30
GENERATED_RETENTION_DAYS=30
MAX_PROCESSING_GENERATIONS_PER_PROFILE=1

# GPT Image 2.5 token rates. Update if OpenAI pricing changes.
IMAGE_TEXT_INPUT_USD_PER_MILLION=5.0
IMAGE_INPUT_USD_PER_MILLION=8.0
IMAGE_OUTPUT_USD_PER_MILLION=30.0
# Optional manual FX rate for admin cost reporting. 0 disables KZT conversion.
USD_KZT_RATE=0
